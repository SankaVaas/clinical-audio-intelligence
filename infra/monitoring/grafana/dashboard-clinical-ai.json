{
  "title": "Clinical Audio Intelligence — Overview",
  "timezone": "utc",
  "panels": [
    { "title": "ASR p95 latency", "type": "timeseries", "targets": [
      { "expr": "histogram_quantile(0.95, sum(rate(asr_latency_seconds_bucket[5m])) by (le))" } ] },
    { "title": "LLM latency by model", "type": "timeseries", "targets": [
      { "expr": "histogram_quantile(0.95, sum(rate(llm_latency_seconds_bucket[5m])) by (le, model))" } ] },
    { "title": "LLM error rate", "type": "timeseries", "targets": [
      { "expr": "sum(rate(llm_requests_total{status=\"error\"}[5m])) / sum(rate(llm_requests_total[5m]))" } ] },
    { "title": "Risk flags by severity", "type": "timeseries", "targets": [
      { "expr": "sum(rate(risk_flags_total[5m])) by (severity)" } ] },
    { "title": "Human review queue depth", "type": "timeseries", "targets": [
      { "expr": "human_review_queue_depth" } ] },
    { "title": "Active sessions by tenant", "type": "timeseries", "targets": [
      { "expr": "active_sessions" } ] },
    { "title": "Audit write failures", "type": "stat", "targets": [
      { "expr": "increase(audit_write_failures_total[1h])" } ] },
    { "title": "Token spend (proxy) by model", "type": "timeseries", "targets": [
      { "expr": "sum(rate(llm_tokens_total[5m])) by (model, direction)" } ] },
    { "title": "Pod restarts", "type": "timeseries", "targets": [
      { "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"clinical-ai\"}[15m])" } ] },
    { "title": "HPA current vs max replicas", "type": "timeseries", "targets": [
      { "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"clinical-ai\"}" } ] }
  ]
}
